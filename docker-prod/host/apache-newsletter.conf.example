# Legacy host-Apache example (not the epssdocker03 path).
# On epssdocker03, use apache-faculty-web/newsletter.epss.ucla.edu.conf instead
# (vhosts live in /opt/faculty/apache/sites-enabled inside faculty-web-1).

<VirtualHost *:80>
    ServerName newsletter.epss.ucla.edu
    RewriteEngine On
    RewriteRule ^(.*)$ https://%{HTTP_HOST}$1 [R=301,L]
</VirtualHost>

<VirtualHost *:443>
    ServerName newsletter.epss.ucla.edu

    SSLEngine on
    SSLCertificateFile      /etc/letsencrypt/live/newsletter.epss.ucla.edu.cert/fullchain.pem
    SSLCertificateKeyFile   /etc/letsencrypt/live/newsletter.epss.ucla.edu.cert/privkey.pem

    ProxyPreserveHost On
    ProxyPass        / http://127.0.0.1:8088/
    ProxyPassReverse / http://127.0.0.1:8088/

    RequestHeader set X-Forwarded-Proto "https"
</VirtualHost>
