# Legacy host-nginx example (not the epssdocker03 faculty-web path).
# Prefer docker-prod/host/apache-faculty-web/newsletter.epss.ucla.edu.conf on epssdocker03.

server {
    listen 80;
    listen [::]:80;
    server_name newsletter.epss.ucla.edu;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name newsletter.epss.ucla.edu;

    ssl_certificate     /etc/letsencrypt/live/newsletter.epss.ucla.edu.cert/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/newsletter.epss.ucla.edu.cert/privkey.pem;

    location / {
        proxy_pass http://127.0.0.1:8088;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
