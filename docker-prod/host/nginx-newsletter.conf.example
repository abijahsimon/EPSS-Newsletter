# Optional: nginx server block when nginx (not Apache) already owns :80/:443.
# Proxy only newsletter.epss.ucla.edu → loopback newsletter container.
#
#   sudo cp nginx-newsletter.conf.example /etc/nginx/sites-available/newsletter
#   sudo ln -sf /etc/nginx/sites-available/newsletter /etc/nginx/sites-enabled/
#   sudo nginx -t && sudo systemctl reload nginx

server {
    listen 80;
    listen [::]:80;
    server_name newsletter.epss.ucla.edu;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name newsletter.epss.ucla.edu;

    ssl_certificate     /etc/letsencrypt/live/newsletter.epss.ucla.edu/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/newsletter.epss.ucla.edu/privkey.pem;

    location / {
        proxy_pass http://127.0.0.1:8088;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
