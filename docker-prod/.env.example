# Copy to docker-prod/.env on epssdocker03 (root-owned, mode 600). Never commit real values.

# Image tag written by bin/deploy
NEWSLETTER_IMAGE=newsletter:prod

# Loopback publish for Host-header / local smoke (faculty-web uses Docker DNS)
NEWSLETTER_HOST_PORT=8088

# External Docker network shared with faculty-web-1 (and print). Must exist before deploy.
# Override only if the faculty compose project uses a different network name.
NEWSLETTER_PROXY_NETWORK=faculty_default

# Leave empty on epssdocker03 (faculty-web owns :80/:443). Traefik profile is for
# greenfield hosts only — still requires NEWSLETTER_PROXY_NETWORK to exist (create
# an empty bridge with that name, or point this at another existing network).
COMPOSE_PROFILES=

# Post-deploy health budget (seconds)
DEPLOY_HEALTH_WAIT=90

# Host-header smoke against loopback (always on). Does not touch public DNS.
SMOKE_HOST_HEADER=newsletter.epss.ucla.edu
SMOKE_TARGET=

# Set to 1 only AFTER DNS A record points at epssdocker03 and CertiNext cert is live.
# Default 0 keeps Squarespace undisturbed during bring-up.
SMOKE_PUBLIC=0
NEWSLETTER_PUBLIC_URL=https://newsletter.epss.ucla.edu/

# CertiNext PEM paths (for docs / Traefik file provider) use the `.cert` lineage:
#   /etc/letsencrypt/live/newsletter.epss.ucla.edu.cert/fullchain.pem
#   /etc/letsencrypt/live/newsletter.epss.ucla.edu.cert/privkey.pem
