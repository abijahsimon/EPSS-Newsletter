---
import SiteMetadata from "./SiteMetadata.astro";
import mediaDerivatives from "../data/media-derivatives.json";

interface Props {
  html: string;
  title: string;
  description?: string;
  image?: string;
}

const { html, title, description, image } = Astro.props;
let body = html.match(/<body[^>]*>([\s\S]*?)<\/body>/i)?.[1] ?? html;
const coverSources = mediaDerivatives.coverOrder;
const responsiveImageSources = [...coverSources, "/assets/images/2026/balboa/launch-vehicle.jpg"];
const coverVariants = mediaDerivatives.covers as Record<string, {
  width: number;
  height: number;
  webp: Array<{ src: string; width: number }>;
  jpeg: Array<{ src: string; width: number }>;
  fallback: string;
}>;
const initialCover = coverVariants[coverSources[0]];
const isHome = title === "EPSS Newsletter 2026";
const sizesForCover = (width: number, height: number) =>
  `(max-width: 900px) max(100vw, ${Math.ceil(720 * width / height)}px, ${Math.ceil(100 * width / height)}vh), 100vw`;
const coverSizes = sizesForCover(initialCover.width, initialCover.height);
const srcset = (variants: Array<{ src: string; width: number }>) =>
  variants.map((variant) => `${variant.src} ${variant.width}w`).join(", ");

const routeRewrites = [
  ["/EPSS Annual Newsletter 2026.dc.html#", "/#"],
  ["EPSS Annual Newsletter 2026.dc.html#", "/#"],
  ["/EPSS Annual Newsletter 2026.dc.html", "/"],
  ["EPSS Annual Newsletter 2026.dc.html", "/"],
  ["index.html#", "/#"],
  ["index.html", "/"],
  ["/art-and-science.html", "/stories/art-science/"],
  ["art-and-science.html", "/stories/art-science/"],
  ["/awards-2026.html", "/stories/awards-2026/"],
  ["awards-2026.html", "/stories/awards-2026/"],
  ["/balboa.html", "/stories/balboa/"],
  ["balboa.html", "/stories/balboa/"],
  ["/commencement-2026.html", "/stories/commencement-2026/"],
  ["commencement-2026.html", "/stories/commencement-2026/"],
  ["/donors-and-endowments.html", "/stories/donors-endowments/"],
  ["donors-and-endowments.html", "/stories/donors-endowments/"],
  ["/gerald-schubert.html", "/stories/gerald-schubert/"],
  ["gerald-schubert.html", "/stories/gerald-schubert/"],
  ["/gilles-peltzer.html", "/stories/gilles-peltzer/"],
  ["gilles-peltzer.html", "/stories/gilles-peltzer/"],
  ["/peter-chi.html", "/stories/peter-chi/"],
  ["peter-chi.html", "/stories/peter-chi/"],
  ["/steve-joy.html", "/stories/steve-joy/"],
  ["steve-joy.html", "/stories/steve-joy/"],
  ["/john-he.html", "/stories/field-highlights/"],
  ["john-he.html", "/stories/field-highlights/"],
  ["/peng-ni.html", "/stories/peng-ni/"],
  ["peng-ni.html", "/stories/peng-ni/"],
  ["/lizzie-su.html", "/stories/lizzie-su/"],
  ["lizzie-su.html", "/stories/lizzie-su/"],
  ["/edwin-schauble.html", "/stories/edwin-schauble/"],
  ["edwin-schauble.html", "/stories/edwin-schauble/"],
  ["/allen-glazner.html", "/stories/allen-glazner/"],
  ["allen-glazner.html", "/stories/allen-glazner/"],
  ["/epss-through-deep-time.html", "/epss-through-deep-time/"],
  ["epss-through-deep-time.html", "/epss-through-deep-time/"],
  ["/archive-poster.html", "/archive-poster/"],
  ["archive-poster.html", "/archive-poster/"],
] as const;

const mediaRewrites = [
  [
    "/assets/images/2026/rimfax/perseverance-ingenuity.jpg",
    "/assets/images/2026/rimfax/perseverance-ingenuity-mars-nasa-jpl.jpg",
  ],
  [
    "/assets/images/2026/commencement/class-2026-geology-building.jpg",
    "/assets/images/2026/commencement/commencement-class-2026-geology-building.jpg",
  ],
  [
    "/assets/people/lizzy-su.jpeg",
    "/assets/people/lizzie-su.jpeg",
  ],
] as const;

for (const [from, to] of [...routeRewrites, ...mediaRewrites]) {
  body = body.replaceAll(from, to);
}

// Dynamic image paths were authored for HTML files served from the site root.
body = body.replaceAll('src: "assets/', 'src: "/assets/');

const transparentPixel =
  "data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7";

// Avoid a speculative request for the literal template token before DC hydrates.
body = body.replaceAll(
  'src="{{ lightboxSrc }}"',
  `src="${transparentPixel}" data-lightbox-src="{{ lightboxSrc }}"`,
);

// Keep the first content image eager. Preserve all selected images and crops.
let firstContentImage = true;
body = body.replace(/<img\b[^>]*>/gi, (tag) => {
  if (!/src="\/assets\//.test(tag) || /src="\/assets\/brand\//.test(tag)) return tag;
  const isLead = firstContentImage;
  firstContentImage = false;
  const attributes = [
    !/\bdecoding=/.test(tag) ? 'decoding="async"' : "",
    !/\bloading=/.test(tag) ? `loading="${isLead ? "eager" : "lazy"}"` : "",
    isLead && !/\bfetchpriority=/.test(tag) ? 'fetchpriority="high"' : "",
  ].filter(Boolean).join(" ");
  return tag.replace(/<img\b/, `<img ${attributes}`);
});

const setAttribute = (tag: string, name: string, value: string) => {
  const attribute = new RegExp(`\\s${name}=(['"])[^'"]*\\1`, "i");
  return attribute.test(tag)
    ? tag.replace(attribute, ` ${name}="${value}"`)
    : tag.replace(/<img\b/i, `<img ${name}="${value}"`);
};

// Give the initial photographic cover responsive sources immediately. The other
// two are source-free until the reader requests them or the page reaches idle.
body = body.replace(/<img\b[^>]*>/gi, (originalTag) => {
  const originalSrc = originalTag.match(/\bsrc="([^"]+)"/i)?.[1];
  const index = responsiveImageSources.indexOf(originalSrc ?? "");
  if (index < 0) return originalTag;
  const variants = coverVariants[responsiveImageSources[index]];
  if (!variants) return originalTag;
  const isInitial = index === 0;
  const imageSizes = sizesForCover(variants.width, variants.height);
  let imageTag = originalTag;
  let sourceTag = "";
  imageTag = setAttribute(imageTag, "width", String(variants.width));
  imageTag = setAttribute(imageTag, "height", String(variants.height));
  if (!coverSources.includes(originalSrc ?? "")) {
    sourceTag = `<source type="image/webp" srcset="${srcset(variants.webp)}" sizes="100vw">`;
    imageTag = setAttribute(imageTag, "src", variants.fallback);
    imageTag = setAttribute(imageTag, "srcset", srcset(variants.jpeg));
    imageTag = setAttribute(imageTag, "sizes", "100vw");
    return `<picture style="display:block;width:100%">${sourceTag}${imageTag}</picture>`;
  }
  sourceTag = `<source type="image/webp" ${isInitial
    ? `srcset="${srcset(variants.webp)}" sizes="${imageSizes}"`
    : `data-cover-srcset="${srcset(variants.webp)}" data-cover-sizes="${imageSizes}"`}>`;
  if (isInitial) {
    imageTag = setAttribute(imageTag, "src", variants.fallback);
    imageTag = setAttribute(imageTag, "srcset", srcset(variants.jpeg));
    imageTag = setAttribute(imageTag, "sizes", imageSizes);
    imageTag = setAttribute(imageTag, "loading", "eager");
    imageTag = setAttribute(imageTag, "fetchpriority", "high");
    return `<picture style="display:block;width:100%;height:100%">${sourceTag}${imageTag}</picture>`;
  }
  imageTag = setAttribute(imageTag, "data-cover-src", variants.fallback);
  imageTag = setAttribute(imageTag, "data-cover-srcset", srcset(variants.jpeg));
  imageTag = setAttribute(imageTag, "data-cover-sizes", imageSizes);
  imageTag = setAttribute(imageTag, "src", transparentPixel);
  imageTag = setAttribute(imageTag, "loading", "lazy");
  imageTag = setAttribute(imageTag, "fetchpriority", "low");
  return `<picture style="display:block;width:100%;height:100%">${sourceTag}${imageTag}</picture>`;
});
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <SiteMetadata title={title} description={description} image={image} />
    <link rel="icon" href="/assets/brand/epss-department-logo.svg" type="image/svg+xml" />
    {isHome && <link rel="preload" as="image" type="image/webp" href={initialCover.webp.find((variant) => variant.width >= 1200)?.src ?? initialCover.webp.at(-1)?.src} imagesrcset={srcset(initialCover.webp)} imagesizes={coverSizes} fetchpriority="high" />}
    <script is:inline src="/support.js"></script>
  </head>
  <body>
    <noscript><p style="padding:1rem;background:#fbfaf7;color:#101820">This newsletter uses JavaScript for its interactive layout. Please enable JavaScript, or <a href="https://epss.ucla.edu/department-newsletters/">browse the newsletter PDFs</a>.</p></noscript>
    <Fragment set:html={body} />
    <script>
      import "../scripts/dialog-focus";
      import "../scripts/fragment-navigation";
    </script>
    <script is:inline define:vars={{ transparentPixel }}>
      // DC replaces the source tree when it mounts. Bind to each connected
      // cover track rather than retaining a reference to the detached template.
      const initializedCoverTracks = new WeakSet();
      const setupCovers = () => {
        const coverTrack = document.querySelector(".cover-track");
        if (!coverTrack?.isConnected || initializedCoverTracks.has(coverTrack)) return;
        initializedCoverTracks.add(coverTrack);
        const coverImages = [...coverTrack.querySelectorAll(".cover-slide img[data-cover-src]")];
        let pendingCoverIntent = null;
        let coverIntentSerial = 0;
        const ensureCoverLoaded = (img, priority = "low") => {
          if (img.dataset.coverLoaded === "true" && img.complete && img.naturalWidth > 1) return Promise.resolve(true);
          if (img._coverLoadPromise) return img._coverLoadPromise;
          img.loading = "eager";
          img.fetchPriority = priority;
          const source = img.parentElement.querySelector("source[data-cover-srcset]");
          if (source) {
            source.sizes = source.dataset.coverSizes || "100vw";
            source.srcset = source.dataset.coverSrcset;
            source.removeAttribute("data-cover-srcset");
          }
          img.sizes = img.dataset.coverSizes || "100vw";
          img.srcset = img.dataset.coverSrcset;
          img.src = img.dataset.coverSrc;
          const decodeImage = () => {
            if (img.complete && img.naturalWidth > 1) return Promise.resolve();
            return img.decode ? img.decode() : new Promise((resolve, reject) => {
              img.addEventListener("load", resolve, { once: true });
              img.addEventListener("error", reject, { once: true });
            });
          };
          img._coverLoadPromise = decodeImage().catch(() => {
            // A failed WebP still needs a decoded JPEG before it can be shown.
            img.parentElement.querySelector("source[type='image/webp']")?.removeAttribute("srcset");
            img.removeAttribute("srcset");
            img.src = img.dataset.coverSrc;
            return decodeImage();
          }).then(() => {
            if (img.naturalWidth <= 1) throw new Error("Cover image unavailable");
            img.dataset.coverLoaded = "true";
            return true;
          }).catch(() => {
            img.dataset.coverLoaded = "false";
            img._coverLoadPromise = undefined;
            return false;
          });
          return img._coverLoadPromise;
        };
        if (coverTrack && coverImages.length) {
          const controls = document.querySelector(".cover-controls");
          controls?.addEventListener("click", (event) => {
            const button = event.target.closest("button[aria-label='Next cover image'], button[aria-label='Previous cover image']");
            if (!button) return;
            // Inline transform is the intended slide. Computed transform is an
            // interpolated position during animation and can select the wrong
            // image when a reader advances again before the transition ends.
            const offset = /translateX\((-?[\d.]+)%\)/.exec(coverTrack.style.transform);
            const slideCount = coverTrack.querySelectorAll(".cover-slide").length;
            const current = Math.round(Math.abs(Number(offset?.[1] || 0)) / (100 / slideCount));
            const direction = button.getAttribute("aria-label").startsWith("Next") ? 1 : -1;
            const target = (current + direction + slideCount) % slideCount;
            const targetImage = coverTrack.querySelectorAll(".cover-slide img")[target];
            if (pendingCoverIntent?.button === button && pendingCoverIntent.targetImage === targetImage) {
              event.preventDefault();
              event.stopImmediatePropagation();
              return;
            }
            const intent = ++coverIntentSerial;
            pendingCoverIntent = null;
            if (!targetImage?.hasAttribute("data-cover-src") || (targetImage.dataset.coverLoaded === "true" && targetImage.complete && targetImage.naturalWidth > 1)) return;
            event.preventDefault();
            event.stopImmediatePropagation();
            // Manual navigation pauses autoplay immediately, including while
            // loading. A later request supersedes an earlier pending request.
            const play = controls.querySelector(".cover-play");
            if (play?.getAttribute("aria-label") === "Pause cover images") play.click();
            pendingCoverIntent = { button, targetImage, intent };
            ensureCoverLoaded(targetImage, "high").then((ready) => {
              if (intent !== coverIntentSerial) return;
              pendingCoverIntent = null;
              if (ready && coverTrack.isConnected) button.click();
            });
          }, true);
          const loadRemainingCovers = () => {
            const runIdle = (callback, timeout = 2500) => window.requestIdleCallback
              ? window.requestIdleCallback(callback, { timeout })
              : window.setTimeout(callback, 500);
            const loadNext = (index) => {
              if (index >= coverImages.length) return;
              runIdle(() => ensureCoverLoaded(coverImages[index], "low").then(() => {
                window.setTimeout(() => loadNext(index + 1), 1800);
              }));
            };
            loadNext(0);
          };
          if (document.readyState === "complete") loadRemainingCovers();
          else window.addEventListener("load", loadRemainingCovers, { once: true });
        }
      };

      const syncDynamicImages = () => {
        setupCovers();
        document.querySelectorAll("img[data-lightbox-src]").forEach((image) => {
          const source = image.getAttribute("data-lightbox-src");
          if (source && !source.includes("{{") && image.getAttribute("src") !== source) {
            image.setAttribute("src", source || transparentPixel);
          }
        });
      };

      new MutationObserver(syncDynamicImages).observe(document.body, {
        attributes: true,
        childList: true,
        subtree: true,
      });
      syncDynamicImages();

    </script>
  </body>
</html>
